# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string. Use MongoDB Atlas for production.
# Example (Atlas): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/loan-tracker
# Example (local): mongodb://localhost:27017/loan-tracker
MONGODB_URI=mongodb://localhost:27017/loan-tracker

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign and verify JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# ─── Email (optional) ────────────────────────────────────────────────────────
# Resend API key — create one at https://resend.com/api-keys
# If omitted, email notifications are silently skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address for notification emails.
# Must be a verified domain/address in your Resend account.
FROM_EMAIL=notifications@yourdomain.com

# ─── App URL (optional) ──────────────────────────────────────────────────────
# The public base URL of your app. Used in email links.
# Include protocol and no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
