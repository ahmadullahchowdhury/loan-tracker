# Ignore node_modules everywhere
**/node_modules/

# Ignore logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# OS junk
.DS_Store
Thumbs.db

# Environment variables
**/.env
**/.env.local
**/.env.*.local

# Vite cache
**/.vite/

# Build output
**/dist/
**/build/

# TypeScript cache
**/tsconfig.tsbuildinfo

# Editor junk
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Optional: lockfiles depending on your package manager
# If using only npm:
# yarn.lock
# If using only yarn:
# package-lock.json
# If using pnpm:
# pnpm-lock.yaml

# Coverage reports
**/coverage/

# PM2 process logs
**/pids
**/*.pid
**/*.seed

# Misc
**/.eslintcache
**/.turbo/
**/.cache/
